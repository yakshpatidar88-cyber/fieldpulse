# FieldPulse Production Deployment Configuration (.env.production)
# Configure these variables when deploying the frontend to Vercel, Netlify, or Cloudflare Pages.

# Backend API Root URL (point to your deployed Spring Boot service on Render or Railway)
VITE_API_BASE_URL=https://fieldpulse-api.onrender.com/api/v1

# WebSocket / SockJS Endpoint URL
VITE_WS_URL=https://fieldpulse-api.onrender.com/ws
