# FieldPulse Root .gitignore

# Operating System
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# Editors and IDEs
.idea/
*.iml
.vscode/
*.swp
*.swo
.project
.classpath
.settings/

# Backend (Java / Spring Boot / Maven / Gradle)
backend/target/
backend/*.jar
backend/*.war
backend/.mvn/timing.properties
backend/.mvn/wrapper/maven-wrapper.jar
backend/build/
backend/.gradle/

# Frontend (Node / React / Vite)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env.local
frontend/.env.*.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# Logs & Runtime data
logs/
*.log
*.pid

# Environment variables & secrets
.env
*.env
!.env.example
secrets/

# Database / Local storage
data/
postgres-data/
redis-data/

# Testing & Coverage
coverage/
.nyc_output/
jacoco/
